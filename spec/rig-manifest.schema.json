{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tinyviber/human3d/spec/rig-manifest.schema.json",
  "title": "RigManifest",
  "description": "Rig manifest v1: bone topology, rest local TRS, world-space rest joint positions, and a semantic bone map (VRM humanoid vocabulary; unmapped bones are 'extra'). Rest local rotation is identity [0,0,0,1] and rest scale is [1,1,1] by construction — the source GLB nodes carry translation only.",
  "type": "object",
  "required": ["schemaVersion","kind","id","units","frame","height","bones","semantics","license","manifestSHA256","sourceSHA256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "rig-manifest"},
    "id": {"type": "string"},
    "units": {"type": "object", "required": ["length","angle"], "properties": {"length": {"const": "meter"}, "angle": {"const": "radian"}}, "additionalProperties": false},
    "frame": {"type": "object", "required": ["handedness","up","forward"], "properties": {"handedness": {"const": "right"}, "up": {"const": "+Y"}, "forward": {"const": "+Z"}}, "additionalProperties": false},
    "height": {"type": "number"},
    "bones": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name","parent","restLocal","head","tail","semantic"],
        "properties": {
          "name": {"type": "string"},
          "parent": {"type": ["string","null"]},
          "restLocal": {
            "type": "object", "required": ["translation","rotation","scale"],
            "properties": {
              "translation": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
              "rotation": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
              "scale": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
            },
            "additionalProperties": false
          },
          "head": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "World-space rest joint position."},
          "tail": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "semantic": {"type": "string", "description": "VRM humanoid bone name, or 'extra' for helper/twist/face bones."}
        },
        "additionalProperties": false
      }
    },
    "semantics": {
      "type": "object", "required": ["vocabulary","mapped","extra"],
      "properties": {"vocabulary": {"const": "vrm-humanoid-1.0"}, "mapped": {"type": "integer"}, "extra": {"type": "integer"}},
      "additionalProperties": false
    },
    "license": {"type": "object"},
    "manifestSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Sorted-key canonical JSON hash of this manifest minus the hash fields."},
    "sourceSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the source rig.json file bytes."}
  },
  "additionalProperties": false
}
