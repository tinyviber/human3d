{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tinyviber/human3d/spec/motion-request.schema.json",
  "title": "MotionRequest",
  "description": "Body of POST /v1/motions: the envelope only. Each action’s parameters are checked against that action’s own schema from GET /v1/actions/{actionId}. Unknown fields are rejected at every level.",
  "type": "object",
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Optional precondition: the action revision the client expects. A mismatch is 409 precondition_failed."
        },
        "definitionSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Optional precondition: the definition hash the client expects. A mismatch is 409 precondition_failed."
        },
        "parameters": {
          "type": "object",
          "description": "Action-specific parameters; validated against the action schema."
        }
      }
    },
    "rig": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 32
          },
          "format": {
            "type": "string",
            "maxLength": 32
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 60,
          "description": "Output sample rate; the service default is 40."
        }
      }
    }
  }
}
