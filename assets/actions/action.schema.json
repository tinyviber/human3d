{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinesis.local/action.schema.json",
  "title": "Muscle-driven action specification",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "model",
    "simulation",
    "controller",
    "reference",
    "display"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "display": {
      "type": "object",
      "required": [
        "english",
        "description",
        "method",
        "focus"
      ],
      "properties": {
        "english": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneShot": {
          "type": "boolean"
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "objectDescription": {
          "type": "string"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "time",
              "label"
            ],
            "properties": {
              "time": {
                "type": "number",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "handPoseSource": {
          "type": "string",
          "enum": [
            "muscle-state",
            "task-keyframe-retarget"
          ]
        },
        "leftGuardHandPoseDeg": {
          "type": "object",
          "required": ["thumb", "fingers"],
          "properties": {
            "thumb": {
              "type": "object",
              "required": ["cmcFlexion", "cmcOpposition", "mcp", "ip"],
              "properties": {
                "cmcFlexion": {"type": "number"},
                "cmcOpposition": {"type": "number"},
                "mcp": {"type": "number"},
                "ip": {"type": "number"}
              },
              "additionalProperties": false
            },
            "fingers": {
              "type": "object",
              "required": ["2", "3", "4", "5"],
              "properties": {
                "2": {"$ref": "#/$defs/fingerPoseDeg"},
                "3": {"$ref": "#/$defs/fingerPoseDeg"},
                "4": {"$ref": "#/$defs/fingerPoseDeg"},
                "5": {"$ref": "#/$defs/fingerPoseDeg"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "xml",
        "metadata"
      ],
      "properties": {
        "xml": {
          "type": "string"
        },
        "metadata": {
          "type": "string"
        },
        "carriedObject": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "required": [
        "stepSeconds",
        "sampleHz",
        "controllerHz"
      ],
      "properties": {
        "stepSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sampleHz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "controllerHz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "leadSeconds": {
          "type": "number",
          "minimum": 0
        },
        "tailSeconds": {
          "type": "number",
          "minimum": 0
        },
        "referenceSpeedScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "startPose": {
          "type": "string",
          "enum": ["neutral", "first-keyframe"]
        }
      },
      "additionalProperties": false
    },
    "controller": {
      "type": "object",
      "required": [
        "controlledActuatorRanges"
      ],
      "properties": {
        "controlledActuatorRanges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "capacityPerturbation": {
          "type": "object",
          "required": [
            "actuatorRange",
            "strengthScale"
          ],
          "properties": {
            "actuatorRange": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "strengthScale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "positionGain": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "velocityGain": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "accelerationLimit": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": [
        "kind",
        "source",
        "coordinateFrame"
      ],
      "properties": {
        "kind": {
          "enum": [
            "captured-points",
            "task-keyframes"
          ]
        },
        "armControl": {
          "type": "string",
          "enum": ["endpoint-keyframes", "joint-keyframes"]
        },
        "source": {
          "type": "object"
        },
        "coordinateFrame": {
          "type": "string"
        },
        "captureId": {
          "type": "string"
        },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "timeSeconds",
              "phase"
            ],
            "properties": {
              "timeSeconds": {
                "type": "number",
                "minimum": 0
              },
              "phase": {
                "type": "string"
              },
              "pelvisYawDeg": {
                "type": "number"
              },
              "jointTargetsDeg": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "elbow": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "hand": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "leftElbow": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 3,
                "maxItems": 3
              },
              "leftHand": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 3,
                "maxItems": 3
              },
              "rightShoulderRotvecRad": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 3,
                "maxItems": 3
              },
              "rightElbowFlexionRad": {
                "type": "number",
                "minimum": 0,
                "maximum": 3.2
              }
            },
            "additionalProperties": false
          }
        },
        "scalarJointKeyframes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "timeSeconds",
              "targetsDeg"
            ],
            "properties": {
              "timeSeconds": {
                "type": "number",
                "minimum": 0
              },
              "targetsDeg": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
  ,"$defs": {
    "fingerPoseDeg": {
      "type": "object",
      "required": ["mcp", "pip", "dip"],
      "properties": {
        "mcp": {"type": "number"},
        "pip": {"type": "number"},
        "dip": {"type": "number"}
      },
      "additionalProperties": false
    }
  }
}
