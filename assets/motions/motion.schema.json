{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinesis.local/motion.schema.json",
  "title": "Motion file envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "order"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "workshop-motion",
        "clip-motion",
        "dynamics-motion"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "english": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "description": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "oneShot": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prop": {
          "type": "object",
          "required": [
            "kind",
            "trail",
            "handView"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "racket"
            },
            "trail": {
              "type": "boolean"
            },
            "handView": {
              "type": "boolean"
            },
            "side": {
              "type": "string",
              "enum": ["R", "L"],
              "description": "Wrist the prop mounts on; absent means 'R'."
            }
          }
        },
        "camera": {
          "type": "object",
          "required": [
            "targetHeight",
            "distance"
          ],
          "additionalProperties": false,
          "properties": {
            "targetHeight": {
              "type": "number"
            },
            "distance": {
              "type": "number"
            }
          }
        },
        "locomotion": {
          "enum": [
            "in-place",
            "follow"
          ]
        }
      }
    },
    "document": {
      "type": "object"
    },
    "clip": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "meta": {
          "type": "string"
        }
      }
    },
    "dynamics": {
      "type": "object",
      "required": [
        "action",
        "records"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "object",
          "description": "The muscle-action parameter payload; validated against dynamics-action.schema.json."
        },
        "records": {
          "type": "object",
          "required": [
            "baseline"
          ],
          "additionalProperties": false,
          "properties": {
            "baseline": {
              "type": "object",
              "required": [
                "meta",
                "data"
              ],
              "additionalProperties": false,
              "properties": {
                "meta": {
                  "type": "string"
                },
                "data": {
                  "type": "string"
                }
              }
            },
            "weak": {
              "type": "object",
              "required": [
                "meta",
                "data"
              ],
              "additionalProperties": false,
              "properties": {
                "meta": {
                  "type": "string"
                },
                "data": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workshop-motion"
          }
        }
      },
      "then": {
        "required": [
          "document",
          "name",
          "english",
          "duration",
          "description",
          "method",
          "focus",
          "phases"
        ],
        "properties": {
          "document": {
            "type": "object"
          },
          "name": true,
          "english": true,
          "duration": true,
          "description": true,
          "method": true,
          "focus": true,
          "phases": true,
          "clip": false,
          "dynamics": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clip-motion"
          }
        }
      },
      "then": {
        "required": [
          "clip",
          "name",
          "english",
          "duration",
          "description",
          "method",
          "focus",
          "phases"
        ],
        "properties": {
          "clip": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              }
            }
          },
          "name": true,
          "english": true,
          "duration": true,
          "description": true,
          "method": true,
          "focus": true,
          "phases": true,
          "document": false,
          "dynamics": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dynamics-motion"
          }
        }
      },
      "then": {
        "required": [
          "dynamics"
        ],
        "properties": {
          "dynamics": {
            "type": "object"
          },
          "document": false,
          "clip": false,
          "name": false,
          "english": false,
          "duration": false,
          "description": false,
          "method": false,
          "focus": false,
          "phases": false,
          "oneShot": false,
          "capabilities": false,
          "notes": false,
          "license": false
        }
      }
    }
  ]
}
