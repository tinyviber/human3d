{
  "name": "human3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @human3d/web",
    "build": "tsc -b && npm run build --workspace @human3d/web",
    "preview": "npm run preview --workspace @human3d/web",
    "test": "vitest run",
    "spec:check": "vitest run apps/server/src/contract.test.ts",
    "service": "tsx apps/server/src/serve.ts",
    "protocol:example": "tsx scripts/export-pose-package.mts",
    "package-to-glb": "tsx scripts/package-to-glb.mts",
    "qa": "node scripts/browser-qa.mjs",
    "assets": "python3 scripts/build-human.py && tsx scripts/retarget-walk.mjs",
    "dynamics:validate": "python3 scripts/validate-action-spec.py",
    "dynamics:test": "python3 scripts/test-dynamics-records.py",
    "dynamics:new": "python3 scripts/new-muscle-action.py",
    "dynamics:build": "python3 scripts/build-muscle-action.py",
    "qa:dynamics": "node scripts/dynamics-browser-qa.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "js-yaml": "^5.5.0",
    "playwright": "^1.55.0",
    "three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
