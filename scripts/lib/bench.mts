// Workshop-pipeline performance baseline — the measurement library behind
// scripts/bench-workshop.mts (issue #10 WP-A). Pure TS: NO node imports —
// the CLI injects now()/heapUsed()/gc and owns all IO, so this module stays
// importable from tests. All reported timings are MICROSECONDS (µs).
//
// What is measured:
//  - runStageLoop: the per-sample stages of solveWorkshop's sampler on the
//    PR-B compiled pipeline — compileMotion once per rep, then
//    frameAtCompiled → solveEffectiveFrame → analyzePose per sample — on the
//    EXACT instants the sampler visits (capture grid + authored key times).
//    The compat path (buildModel/frameFromModel/frameAt/samplePose) stays
//    measured as stride-subset cross-checks — the PR-B vs PR-A delta is the
//    evidence, so the old cost is never dropped from the record.
//  - runWholeCalls: rep-level totals for the whole calls — solveWorkshop,
//    JSON.stringify(pkg), probeFrames, analyzeProbeFrames and the one-shot
//    probeDocument — with heap churn when the caller injects memory probes.
//  - summarizeScenario folds both into the baseline's per-scenario record;
//    the residual (solveWorkshop total minus the summed stage totals) is
//    the events/assembly/serialization-adjacent remainder — reported under
//    the honest name captureSerialize together with stringify, NEVER render.
import {MathUtils,Object3D,Vector3,type Quaternion} from 'three';
import {analyzePose,analyzeProbeFrames,blankDocument,buildModel,compileMotion,constraintsAt,defaultDocument,
 DORSI_LIMIT_DEG,footRotation,frameAt,frameAtCompiled,frameFromModel,HumanRig,motionFileById,mulberry32,
 pelvisDorsiCorrection,probeDocument,probeFrames,randomDoc,retimeKeys,samplePose,sampleTimes,serializeDoc,
 solveEffectiveFrame,solveWorkshop,sortedKeys,toV,validateDocShape,
 type DorsiLeg,type ProbeTip,type WorkshopDoc,type WorkshopKey} from '@human3d/motion-core';
export {sampleTimes};

/** Upper-middle median (the repo convention, quality-probe's median). */
export const medianOf=(xs:number[])=>{const s=[...xs].sort((a,b)=>a-b);return s[Math.floor(s.length/2)]??0;};
/** Nearest-rank p95: sorted[ceil(0.95·n)−1]. */
export const p95Of=(xs:number[])=>{const s=[...xs].sort((a,b)=>a-b);return s.length?s[Math.ceil(.95*s.length)-1]:0;};

/** Distribution stats over a timing series (µs). */
export interface StageStat{n:number;median:number;p95:number;min:number;max:number}
export function summarize(xs:number[]):StageStat{
 const s=[...xs].sort((a,b)=>a-b),n=s.length;
 return {n,median:n?s[Math.floor(n/2)]:0,p95:n?s[Math.ceil(.95*n)-1]:0,min:n?s[0]:0,max:n?s[n-1]:0};
}

/* ---- bench documents -------------------------------------------------- */

/** One scenario's document recipe. `bench` docs are generated by
 * buildBenchDoc; the other builders reuse real shipped documents. */
export interface BenchDocSpec{
 name:string;
 builder:'defaultDocument'|'motionFile'|'bench';
 /** motionFile builder: MOTION_FILES id (e.g. 'forehand'). */
 motionId?:string;
 /** bench builder: key count / duration / PRNG seed / in-betweens flag. */
 keys?:number;duration?:number;seed?:number;inbetweens?:boolean;
}
export interface BenchGenSpec{keys:number;duration:number;seed:number;inbetweens?:boolean;name?:string}

/** Re-keyed document: a seeded randomDoc trajectory re-sampled onto `keys`
 * evenly spaced keys over `duration`. The SOURCE clone is retimed, then
 * sampled with samplePose (always Hermite — it never reads the source's
 * inbetweens flag) for poses and constraintsAt for constraints.
 * `spec.inbetweens` lands on the OUTPUT doc — false exercises frameAt's
 * flat constraintsAt+unflattenPose branch (the nib scenario). */
export function buildBenchDoc(spec:BenchGenSpec,rest:ReadonlyMap<string,Vector3>,rng:()=>number=mulberry32(spec.seed)):WorkshopDoc{
 const src=randomDoc(rng,rest);
 const srcR=JSON.parse(serializeDoc(src)) as WorkshopDoc;
 retimeKeys(srcR,spec.duration);
 const srcKeys=sortedKeys(srcR),origin=rest.get('root')!;
 const n=Math.max(2,spec.keys);
 const keys:WorkshopKey[]=Array.from({length:n},(_,i)=>{
  const t=i*spec.duration/(n-1);
  return {id:`bk${i}`,time:t,label:'',pose:samplePose(srcR,t,origin),
   constraints:{...constraintsAt(srcKeys,t).constraints}};
 });
 const doc:WorkshopDoc={...blankDocument(rest,spec.name??'bench',`bench-${spec.name??`k${n}-d${spec.duration}`}`),
  duration:spec.duration,inbetweens:spec.inbetweens??true,keys};
 const errs=validateDocShape(doc);
 if(errs.length)throw new Error(`buildBenchDoc(${spec.name??`k${n}-d${spec.duration}`}): ${errs.join(' | ')}`);
 return doc;
}

/** Materialize a scenario's document. Bench docs take spec.seed as their
 * source seed; the shipped builders ignore keys/duration/seed. */
export function resolveBenchDoc(spec:BenchDocSpec,rest:ReadonlyMap<string,Vector3>):WorkshopDoc{
 if(spec.builder==='defaultDocument')return defaultDocument(rest);
 if(spec.builder==='motionFile'){
  const doc=motionFileById(spec.motionId??'')?.document;
  if(!doc)throw new Error(`bench: motion '${spec.motionId}' has no workshop document`);
  return doc;
 }
 return buildBenchDoc({keys:spec.keys??20,duration:spec.duration??5,seed:spec.seed??1,inbetweens:spec.inbetweens,name:spec.name},rest);
}

/* ---- stage loop -------------------------------------------------------- */

export interface StageLoopArgs{
 rig:HumanRig;doc:WorkshopDoc;fps:number;
 /** Discarded passes before the measured reps (JIT/cache warm). */
 warmup:number;reps:number;
 /** Millisecond clock — performance.now. */
 now:()=>number;
 /** Cross-check stride override; default ≈64 cross samples per rep. */
 crossStride?:number;
}
export interface StageLoopResult{
 /** Instants sampled per rep: capture grid PLUS authored key times. */
 samplesPerRep:number;
 /** Per-sample stage timings pooled over measured reps (µs). frameAtCompiled,
  * solveEffectiveFrame and analyzePose pool every measured sample (the PR-B
  * pipeline); buildModel/frameFromModel/frameAt/samplePose are stride-subset
  * cross-checks of the compat path — its cost stays measured so the PR-B vs
  * PR-A delta is honest. */
 perSample:{frameAtCompiled:number[];solveEffectiveFrame:number[];analyzePose:number[];buildModel:number[];frameFromModel:number[];frameAt:number[];samplePose:number[]};
 /** Per-rep stage totals (µs) — the residual subtracts their medians from
  * solveWorkshop's rep-total median, so per-rep granularity is required
  * (Σ per-sample medians × n would mix quantiles). compileMotion is timed
  * once per rep — the hoist IS the PR-B change. */
 repTotals:{compileMotion:number[];frameAtCompiled:number[];solveEffectiveFrame:number[];analyzePose:number[]};
}
export function runStageLoop(a:StageLoopArgs):StageLoopResult{
 const {rig,doc,fps,warmup,reps,now}=a;
 const origin=rig.rest.get('root')!;
 /* The sampled instants solveWorkshop's sampler visits: capture()'s uniform
  * grid PLUS every authored key instant (its extraTimes pass) — a key on a
  * grid point is sampled twice, matching the real call. */
 const times=sampleTimes(doc.duration,fps).concat(sortedKeys(doc).map(k=>k.time)).sort((x,y)=>x-y);
 const stride=Math.max(1,a.crossStride??Math.floor(times.length/64));
 const perSample:StageLoopResult['perSample']={frameAtCompiled:[],solveEffectiveFrame:[],analyzePose:[],buildModel:[],frameFromModel:[],frameAt:[],samplePose:[]};
 const repTotals:StageLoopResult['repTotals']={compileMotion:[],frameAtCompiled:[],solveEffectiveFrame:[],analyzePose:[]};
 for(let pass=0;pass<warmup+reps;pass++){
  const measured=pass>=warmup,sum={frameAtCompiled:0,solveEffectiveFrame:0,analyzePose:0};
  /* One compile per rep — the exact hoist solveWorkshop/probeFrames now do.
   * Timed even on warmup passes so the compiled snapshot exists either way. */
  const c0=now(),compiled=compileMotion(doc,origin),c1=now();
  for(let i=0;i<times.length;i++){
   const t=times[i];
   /* ~4 now() calls per sample ≈ 0.1–0.3µs of bracketing overhead — inside
    * the noise floor for stages that cost ≥10µs. */
   const p0=now(),f=frameAtCompiled(compiled,t);
   const p1=now();solveEffectiveFrame(rig,f);
   const p2=now();analyzePose(rig,f.pose,f.constraints);
   const p3=now();
   if(measured){
    perSample.frameAtCompiled.push((p1-p0)*1000);
    perSample.solveEffectiveFrame.push((p2-p1)*1000);perSample.analyzePose.push((p3-p2)*1000);
    sum.frameAtCompiled+=(p1-p0)*1000;sum.solveEffectiveFrame+=(p2-p1)*1000;sum.analyzePose+=(p3-p2)*1000;
   }
   /* Compat-path cross-checks on a stride subset: the PR-A pipeline's cost
    * (buildModel split from frameFromModel, fused frameAt, always-Hermite
    * samplePose) — frameAt ≈ buildModel + frameFromModel still holds as the
    * wiring sanity check. */
   if(measured&&i%stride===0){
    const q0=now(),m=buildModel(doc,origin);
    const q1=now();frameFromModel(m,doc,t);
    const q2=now();frameAt(doc,t,origin);
    const q3=now();samplePose(doc,t,origin);
    const q4=now();
    perSample.buildModel.push((q1-q0)*1000);perSample.frameFromModel.push((q2-q1)*1000);
    perSample.frameAt.push((q3-q2)*1000);perSample.samplePose.push((q4-q3)*1000);
   }
  }
  rig.reset();
  if(measured){
   repTotals.compileMotion.push((c1-c0)*1000);
   repTotals.frameAtCompiled.push(sum.frameAtCompiled);
   repTotals.solveEffectiveFrame.push(sum.solveEffectiveFrame);repTotals.analyzePose.push(sum.analyzePose);
  }
 }
 return {samplesPerRep:times.length,perSample,repTotals};
}

/* ---- whole calls -------------------------------------------------------- */

export interface WholeCallArgs{
 rig:HumanRig;doc:WorkshopDoc;fps:number;reps:number;warmup?:number;
 now:()=>number;
 /** The capture meta the service would build — workshopMeta output. */
 meta:Parameters<typeof solveWorkshop>[3];
 /** Optional racket tip object for probeFrames/probeDocument. */
 tip?:ProbeTip;
 /** Injected by the CLI: heap bytes + optional gc() for the post-gc trend. */
 mem?:{heapUsed():number;gc?():void};
}
export interface WholeCallResult{
 /** Rep-level totals (µs). */
 totals:{solveWorkshop:number[];stringify:number[];probeFrames:number[];analyzeProbeFrames:number[];probeDocument:number[]};
 /** JSON.stringify(pkg).length of the last measured rep. */
 pkgBytes:number;
 memory:{churnMB:number[];heapPostGcMB:number[]};
}
export function runWholeCalls(a:WholeCallArgs):WholeCallResult{
 const {rig,doc,fps,reps,now,meta,tip,mem}=a,warmup=a.warmup??0;
 const totals:WholeCallResult['totals']={solveWorkshop:[],stringify:[],probeFrames:[],analyzeProbeFrames:[],probeDocument:[]};
 const churnMB:number[]=[],heapPostGcMB:number[]=[];
 let pkgBytes=0;
 for(let pass=0;pass<warmup+reps;pass++){
  const measured=pass>=warmup;
  const h0=mem?.heapUsed();
  const p0=now(),pkg=solveWorkshop(rig,doc,fps,meta);
  const p1=now(),body=JSON.stringify(pkg);
  const p2=now(),frames=probeFrames(rig,doc,fps,tip);
  const p3=now();analyzeProbeFrames({doc,fps,frames,rest:rig.rest});
  const p4=now();probeDocument(rig,doc,{fps,tip});
  const p5=now();
  const h1=mem?.heapUsed();
  if(measured){
   totals.solveWorkshop.push((p1-p0)*1000);totals.stringify.push((p2-p1)*1000);
   totals.probeFrames.push((p3-p2)*1000);totals.analyzeProbeFrames.push((p4-p3)*1000);
   totals.probeDocument.push((p5-p4)*1000);
   pkgBytes=body.length;
   if(h0!==undefined&&h1!==undefined)churnMB.push((h1-h0)/1048576);
   if(mem?.gc){mem.gc();heapPostGcMB.push(mem.heapUsed()/1048576);}
  }
 }
 return {totals,pkgBytes,memory:{churnMB,heapPostGcMB}};
}

/* ---- solve-internal profile (issue #10 PR-C) ------------------------------
 * runSolveProfile instruments one solveEffectiveFrame per sampled instant
 * (the same capture-grid+key-times instants runStageLoop visits) and counts
 * the exact work items the batch-scoped world sync removes:
 *   - Object3D.updateMatrixWorld: `topLevel` counts calls ENTERED on
 *     rig.model (recursion-depth 0 — the forced full-tree flushes);
 *     `nodeVisits` counts every call including the recursive descent (one
 *     per node per flush — SkinnedMesh's override funnels through super,
 *     so it still lands). Both are attributed to the innermost HumanRig
 *     method on the stack (a plain var — every call here is synchronous);
 *     flushes issued directly by solvePose land in '(solver-inline)'.
 *   - Object3D.updateWorldMatrix + getWorldPosition / getWorldQuaternion /
 *     localToWorld / worldToLocal: the scoped reads. Each self-updates its
 *     ancestor chain with the SAME compose/multiply arithmetic the flush
 *     runs — updateWorldMatrix ≈ Σ ancestor depth over the read calls.
 *   - HumanRig.prototype methods: calls + EXCLUSIVE µs (nested rig-method
 *     time subtracts into the caller's `inner`). Each wrap pays 2 now()
 *     brackets ≈40–80ns/call — point()/bone() are hot, so instrumented
 *     solveUs is inflated vs production; the CLI labels it 'instrumented'.
 * Module-bound helpers (pelvisDorsiCorrection, blendGrip/applyGrip,
 * solveTwoBone, footRotation, handFrame, toV…) cannot be prototype-patched:
 * their share lands in residualUs = median(solveUs) − Σ method µs/solve,
 * and pelvisDorsiCorrection is timed directly by the preamble replica.
 * Patches install INSIDE the measured window and restore in finally — the
 * rig and both prototypes leave exactly as they arrived. */
export interface SolveProfileArgs{
 rig:HumanRig;doc:WorkshopDoc;fps:number;now:()=>number;
 /** Unpatched warm-up passes over the grid (JIT), default 1. */
 warmup?:number;
 /** Measured passes over the grid, default 3. */
 reps?:number;
 /** Optional heap probe (CLI injects process.memoryUsage().heapUsed):
  * per-solve deltas, mean reported — noisy, ranking evidence only. */
 heapUsed?:()=>number;
}
export interface SolveProfileResult{
 /** Sampled instants per rep (capture grid + authored key times). */
 samplesPerRep:number;
 /** Measured solves = samplesPerRep × reps. */
 solves:number;
 /** Per-solve solveEffectiveFrame µs WITH instrumentation on. */
 solveUs:number[];
 /** heapUsed delta per solve (bytes; negative = GC inside the bracket). */
 heapDeltaBytes:number[];
 /** Forced flushes entered on rig.model, per solve. */
 umwTopLevelPerSolve:number[];
 /** updateMatrixWorld calls incl. recursive descent, per solve. */
 umwNodeVisitsPerSolve:number[];
 /** umw totals over the run, keyed by innermost rig method (or
  * '(solver-inline)' for flushes issued by solvePose itself). */
 umwByMethod:Record<string,{topLevel:number;nodeVisits:number}>;
 /** Scoped-read call totals over the run. */
 scopedReads:Record<'updateWorldMatrix'|'getWorldPosition'|'getWorldQuaternion'|'localToWorld'|'worldToLocal',number>;
 /** Rig-method totals: calls and EXCLUSIVE µs over the run. */
 rigMethods:Record<string,{calls:number;us:number}>;
 /** Σ rigMethods.us / solves — the attributable share of a solve. */
 attributedUsPerSolve:number;
 /** median(solveUs) − attributedUsPerSolve: solver-inline + module-bound
  * helpers + instrumentation residue. */
 residualUs:number;
 /** Preamble-replica timings: pelvisDorsiCorrection on real per-frame
  * inputs, measured UNPATCHED after restore (µs). */
 pelvisDorsiCorrectionUs:number[];
}
const RIG_PROFILED_METHODS=['reset','rotate','worldRotation','limb','limbToWorldTargets','hand','relaxHand','articulateHand','point','bone','batch','syncWorld','worldPointInto'] as const;
export function runSolveProfile(a:SolveProfileArgs):SolveProfileResult{
 const {rig,doc,fps,now}=a,warmup=a.warmup??1,reps=a.reps??3;
 const origin=rig.rest.get('root')!;
 const times=sampleTimes(doc.duration,fps).concat(sortedKeys(doc).map(k=>k.time)).sort((x,y)=>x-y);
 const compiled=compileMotion(doc,origin);
 const solves=times.length*reps;
 const umw={topLevel:0,nodeVisits:0};
 const umwByMethod:SolveProfileResult['umwByMethod']={};
 const scopedReads:SolveProfileResult['scopedReads']={updateWorldMatrix:0,getWorldPosition:0,getWorldQuaternion:0,localToWorld:0,worldToLocal:0};
 const rigMethods:SolveProfileResult['rigMethods']={};
 /* Attribution + exclusive-time stack: each patched rig method pushes a
  * frame; inner frames add their WHOLE bracket to the parent's `inner`,
  * so each method's `us` is self-time only and Σ methods never
  * double-counts. */
 interface Frame{name:string;t0:number;inner:number}
 const frames:Frame[]=[];
 const attr=()=>frames.length?frames[frames.length-1].name:'(solver-inline)';
 let umwDepth=0;
 const O3=Object3D.prototype;
 const origUmw=O3.updateMatrixWorld,origUwm=O3.updateWorldMatrix,
  origGwp=O3.getWorldPosition,origGwq=O3.getWorldQuaternion,
  origL2w=O3.localToWorld,origW2l=O3.worldToLocal;
 const proto=HumanRig.prototype as unknown as Record<string,((this:HumanRig,...args:never[])=>unknown)|undefined>;
 const origMethods:Record<string,NonNullable<(typeof proto)[string]>>={};
 const patched:string[]=[];
 const install=()=>{
  O3.updateMatrixWorld=function(this:Object3D,force?:boolean){
   const entry=umwDepth===0;umwDepth++;
   try{
    umw.nodeVisits++;
    const m=umwByMethod[attr()]??(umwByMethod[attr()]={topLevel:0,nodeVisits:0});
    m.nodeVisits++;
    /* A rig.model entry counts as topLevel ONLY at depth 0: inside another
     * flush's descent this===model would re-trigger on the way down. */
    if(entry&&this===rig.model){umw.topLevel++;m.topLevel++;}
    return origUmw.call(this,force);
   }finally{umwDepth--;}
  };
  O3.updateWorldMatrix=function(this:Object3D,p:boolean,c:boolean){scopedReads.updateWorldMatrix++;return origUwm.call(this,p,c);};
  O3.getWorldPosition=function(this:Object3D,t:Vector3){scopedReads.getWorldPosition++;return origGwp.call(this,t);};
  O3.getWorldQuaternion=function(this:Object3D,t:Quaternion){scopedReads.getWorldQuaternion++;return origGwq.call(this,t);};
  O3.localToWorld=function(this:Object3D,t:Vector3){scopedReads.localToWorld++;return origL2w.call(this,t);};
  O3.worldToLocal=function(this:Object3D,t:Vector3){scopedReads.worldToLocal++;return origW2l.call(this,t);};
  for(const name of RIG_PROFILED_METHODS){
   const orig=proto[name];
   if(typeof orig!=='function')continue; // method may not exist yet on older rigs
   origMethods[name]=orig;patched.push(name);rigMethods[name]={calls:0,us:0};
   proto[name]=function(this:HumanRig,...args:never[]){
    const t0=now(),f:Frame={name,t0,inner:0};
    frames.push(f);
    try{return orig.apply(this,args);}
    finally{
     const dt=(now()-t0)*1000;frames.pop(); // µs — same unit as solveUs
     rigMethods[name].calls++;rigMethods[name].us+=Math.max(0,dt-f.inner);
     const parent=frames[frames.length-1];if(parent)parent.inner+=dt;
    }
   };
  }
 };
 const restore=()=>{
  O3.updateMatrixWorld=origUmw;O3.updateWorldMatrix=origUwm;
  O3.getWorldPosition=origGwp;O3.getWorldQuaternion=origGwq;
  O3.localToWorld=origL2w;O3.worldToLocal=origW2l;
  for(const n of patched)proto[n]=origMethods[n];
 };
 const solveUs:number[]=[],heap:number[]=[],umwTop:number[]=[],umwVis:number[]=[];
 const pass=(measure:boolean)=>{
  for(const t of times){
   const f=frameAtCompiled(compiled,t);
   const h0=measure?a.heapUsed?.():undefined;
   const bTop=umw.topLevel,bVis=umw.nodeVisits,t0=now();
   solveEffectiveFrame(rig,f);
   const t1=now(),h1=measure?a.heapUsed?.():undefined;
   if(measure){
    solveUs.push((t1-t0)*1000);
    umwTop.push(umw.topLevel-bTop);umwVis.push(umw.nodeVisits-bVis);
    if(h0!==undefined&&h1!==undefined)heap.push(h1-h0);
   }
  }
 };
 for(let i=0;i<warmup;i++)pass(false);
 install();
 try{for(let i=0;i<reps;i++)pass(true);}finally{restore();}
 /* Preamble replica (UNPATCHED): pelvisDorsiCorrection is module-bound, so
  * the profile can't attribute it — instead replay solvePose's pre-pelvis
  * steps verbatim (solver.ts: reset → root offset/yaw → spine/neck/head
  * rotates → legs → dorsiLegs) on the real frames and time the call.
  * Keep the block in sync with solvePose when the preamble changes. */
 const dorsiUs:number[]=[];
 for(const t of times){
  const f=frameAtCompiled(compiled,t),p=f.pose;
  rig.reset();
  const root=rig.bone('root');
  root.position.copy(origin).add(new Vector3(
   MathUtils.clamp(p.root.x,-.6,.6),MathUtils.clamp(p.root.y,-.55,.35),MathUtils.clamp(p.root.z,-.6,.6)));
  rig.rotate('root',0,p.yaw,0);
  for(const n of ['spine05','spine04','spine03','spine02','spine01'])rig.rotate(n,p.lean/5,p.chest/5,p.side/5);
  rig.rotate('neck01',-p.lean*.22,-p.chest*.15,-p.side*.2);rig.rotate('neck02',-p.lean*.22,0,0);rig.rotate('head',-p.lean*.12,0,0);
  const legs=(['L','R']as const).map(side=>{
   const ft=side==='L'?p.footL:p.footR;
   return {side,target:toV(ft.target),pole:toV(ft.pole),footQ:footRotation(ft.yaw,ft.pitch),
    a:rig.rest.get(`upperleg01_${side}`)!.distanceTo(rig.rest.get(`lowerleg01_${side}`)!),
    b:rig.rest.get(`lowerleg01_${side}`)!.distanceTo(rig.rest.get(`foot_${side}`)!)};
  });
  const dorsiLegs:DorsiLeg[]=legs.map(l=>({hip:rig.point(`upperleg01_${l.side}`),target:l.target,pole:l.pole,
   upper:l.a,lower:l.b,footQ:l.footQ,weight:f.support[l.side]}));
  const d0=now();pelvisDorsiCorrection(dorsiLegs,DORSI_LIMIT_DEG,.15);dorsiUs.push((now()-d0)*1000);
 }
 rig.reset();
 const attributed=Object.values(rigMethods).reduce((s,m)=>s+m.us,0)/Math.max(1,solves);
 return {samplesPerRep:times.length,solves,solveUs,heapDeltaBytes:heap,
  umwTopLevelPerSolve:umwTop,umwNodeVisitsPerSolve:umwVis,umwByMethod,scopedReads,rigMethods,
  attributedUsPerSolve:attributed,residualUs:medianOf(solveUs)-attributed,
  pelvisDorsiCorrectionUs:dorsiUs};
}

/* ---- skip-flush experiment (issue #10 PR-C, eval §2) ---------------------
 * Empirical proof that the forced updateMatrixWorld(true) flushes inside a
 * solve are write-only: stub rig.model.updateMatrixWorld to a counting
 * no-op, re-run the whole sampled sweep, and compare the state the flushes
 * could have influenced. The compare set is DELIBERATELY local-quaternion
 * (every bone) + root.position + rig.point() world snapshots — all local or
 * self-updating reads; .matrixWorld is never touched because the final
 * flush is stubbed too, so a stale matrixWorld cannot leak into the
 * comparison. identical ⇒ no solve output depended on the flushes.
 * EXPERIMENT-ONLY: proves observational equivalence; production keeps the
 * batch-end flush as the matrixWorld postcondition for renderers/tests. */
export interface SkipFlushResult{
 solves:number;
 /** Times the stubbed updateMatrixWorld was invoked over the whole run. */
 stubCalls:number;
 /** Scalar components in the compare set per solve. */
 scalarsPerSolve:number;
 /** Total scalars compared (solves × scalarsPerSolve). */
 compared:number;
 identical:boolean;firstMismatch?:string;
}
export function runSkipFlushExperiment(rig:HumanRig,doc:WorkshopDoc,fps:number):SkipFlushResult{
 const origin=rig.rest.get('root')!;
 const times=sampleTimes(doc.duration,fps).concat(sortedKeys(doc).map(k=>k.time)).sort((x,y)=>x-y);
 const compiled=compileMotion(doc,origin);
 const bones=[...rig.bones.keys()];
 const scalarsPerSolve=bones.length*4+3+bones.length*3;
 const snapshot=()=>{
  const out:number[]=[];
  for(const t of times){
   solveEffectiveFrame(rig,frameAtCompiled(compiled,t));
   for(const n of bones){const q=rig.bone(n).quaternion;out.push(q.x,q.y,q.z,q.w);}
   const rp=rig.bone('root').position;out.push(rp.x,rp.y,rp.z);
   for(const n of bones){const p=rig.point(n);out.push(p.x,p.y,p.z);}
  }
  return out;
 };
 const reference=snapshot();
 rig.reset();
 let stubCalls=0;
 const model=rig.model as Object3D&{updateMatrixWorld?:(force?:boolean)=>void};
 const hadOwn=Object.prototype.hasOwnProperty.call(model,'updateMatrixWorld');
 const orig=model.updateMatrixWorld;
 model.updateMatrixWorld=function(){stubCalls++;};
 let test:number[];
 try{test=snapshot();}
 finally{if(hadOwn)model.updateMatrixWorld=orig;else delete (model as {updateMatrixWorld?:unknown}).updateMatrixWorld;}
 rig.reset();
 let firstMismatch:string|undefined;
 for(let i=0;i<reference.length&&firstMismatch===undefined;i++){
  if(!Object.is(reference[i],test[i])){
   const s=Math.floor(i/scalarsPerSolve),j=i%scalarsPerSolve;
   const kind=j<bones.length*4?`quat ${bones[Math.floor(j/4)]}[${j%4}]`
    :j<bones.length*4+3?`root.position[${j-bones.length*4}]`
    :`point ${bones[Math.floor((j-bones.length*4-3)/3)]}[${(j-bones.length*4-3)%3}]`;
   firstMismatch=`solve#${s} t=${times[s]} ${kind}: ${reference[i]} vs ${test[i]}`;
  }
 }
 return {solves:times.length,stubCalls,scalarsPerSolve,compared:reference.length,
  identical:firstMismatch===undefined,firstMismatch};
}

/** Per-cell folded profile record (all µs, counters per solve). */
export interface SolveProfileCell{
 name:string;fps:number;
 /** Sampled instants per rep and measured solves (samplesPerRep × reps). */
 samplesPerRep:number;solves:number;
 /** Instrumented solveEffectiveFrame — inflated by the method brackets
  * (disclosed); the unpatched --compare numbers are the speedup evidence. */
 solveUsInstrumented:TimedStat;
 umw:{topLevelPerSolve:StageStat;nodeVisitsPerSolve:StageStat;
  /** Run totals by innermost rig method ('(solver-inline)' = flushes issued
   * by solvePose itself). */
  byMethod:Record<string,{topLevel:number;nodeVisits:number}>};
 scopedReadsPerSolve:Record<string,number>;
 /** callsPerSolve and EXCLUSIVE µs/solve per rig method. */
 rigMethodsPerSolve:Record<string,{callsPerSolve:number;usPerSolve:number}>;
 attributedUsPerSolve:number;
 /** median(solveUs) − attributedUsPerSolve: solver-inline + module-bound
  * helpers (pelvisDorsiCorrection, blendGrip/applyGrip, solveTwoBone, toV…)
  * + instrumentation residue. */
 residualUs:number;
 /** Preamble-replica timings of the module-bound pelvisDorsiCorrection. */
 pelvisDorsiCorrectionUs:StageStat;
 /** heapUsed delta per solve — noisy, ranking evidence only. */
 heapDeltaBytesPerSolve:{mean:number;median:number};
 /** Present only under --profile-skip-flush (experiment-only). */
 skipFlush?:SkipFlushResult;
}
export interface SolveProfileFile{
 bench:'solve-profile';version:1;
 run:BaselineFile['run'];
 disclosures:string[];
 scenarios:SolveProfileCell[];
}
export const SOLVE_PROFILE_DISCLOSURES=[
 'solveUsInstrumented：计时含插桩开销——每个 rig 方法调用包 2×now() ≈40–80ns，point/bone 为高频热点，故绝对值高于未插桩的 --compare 数字；计数器不受计时噪声影响。',
 'residualUs = median(solveUs) − Σ方法独占µs/solve —— solver 内联代码 + 模块绑定不可插桩函数（pelvisDorsiCorrection 由前导复制品单独计时；blendGrip/applyGrip、solveTwoBone、footRotation、handFrame、toV 等）。',
 'umw.topLevel = 在 rig.model 上以递归深度 0 进入 updateMatrixWorld 的次数（强制全树 flush）；umw.nodeVisits = 含递归下降的总调用数（每节点每 flush 一次；SkinnedMesh 覆写经 super 计入）。',
 'scopedReads：updateWorldMatrix 计数含其祖先递归——≈各自更新读路径上的祖先深度总和；updateWorldMatrix 与 updateMatrixWorld 共用 compose/multiply 算术。',
 'heapDeltaBytesPerSolve = 单次 solveEffectiveFrame 的 heapUsed 差（可为负=GC）；仅排序参考。',
 'skipFlush（experiment-only）：桩死 rig.model.updateMatrixWorld 后整段重放，比对集 = 全部局部四元数 + root.position + rig.point() 世界快照（自更新/局部读，不读 .matrixWorld——末次 flush 同样被桩）；identical ⇒ 中途 flush 是只写状态。',
];
export function summarizeProfileCell(spec:BenchDocSpec,fps:number,pr:SolveProfileResult,exp?:SkipFlushResult):SolveProfileCell{
 const solves=Math.max(1,pr.solves);
 const rigMethodsPerSolve:SolveProfileCell['rigMethodsPerSolve']={};
 for(const [n,m]of Object.entries(pr.rigMethods))rigMethodsPerSolve[n]={callsPerSolve:r4(m.calls/solves),usPerSolve:r4(m.us/solves)};
 const scopedReadsPerSolve:Record<string,number>={};
 for(const [n,c]of Object.entries(pr.scopedReads))scopedReadsPerSolve[n]=r4(c/solves);
 const heap=pr.heapDeltaBytes;
 return {name:spec.name,fps,samplesPerRep:pr.samplesPerRep,solves:pr.solves,
  solveUsInstrumented:{...r4s(summarize(pr.solveUs)),per:'sample'},
  umw:{topLevelPerSolve:r4s(summarize(pr.umwTopLevelPerSolve)),
   nodeVisitsPerSolve:r4s(summarize(pr.umwNodeVisitsPerSolve)),byMethod:pr.umwByMethod},
  scopedReadsPerSolve,rigMethodsPerSolve,
  attributedUsPerSolve:r4(pr.attributedUsPerSolve),residualUs:r4(pr.residualUs),
  pelvisDorsiCorrectionUs:r4s(summarize(pr.pelvisDorsiCorrectionUs)),
  heapDeltaBytesPerSolve:{mean:r4(heap.length?heap.reduce((x,y)=>x+y,0)/heap.length:0),median:r4(medianOf(heap))},
  skipFlush:exp};
}

/** Human-readable profile table (zh conventions like formatProbeReport). */
export function formatProfileReport(p:SolveProfileFile):string{
 const lines:string[]=[];
 const e=p.run.env;
 lines.push(`=== solve-profile 求解内部计数 · ${p.run.date} ===`);
 lines.push(`env: node ${e.node} ${e.platform}-${e.arch} · ${e.cpu} ${e.cores}核 ${e.totalMemGB}GB · three ${e.three} · tsx ${e.tsx} · commit ${p.run.commit.slice(0,7)}`);
 lines.push(`cmd: ${p.run.command}`);
 for(const d of p.disclosures)lines.push(`注: ${d}`);
 for(const s of p.scenarios){
  lines.push(`\n=== ${s.name} @${s.fps}fps · ${s.samplesPerRep} samples × ${s.solves/s.samplesPerRep} reps = ${s.solves} solves ===`);
  lines.push(`  solveEffectiveFrame (插桩)  med ${fmtUs(s.solveUsInstrumented.median)} p95 ${fmtUs(s.solveUsInstrumented.p95)}`);
  lines.push(`  umw.topLevel/solve          med ${s.umw.topLevelPerSolve.median}  (rig.model 强制全树 flush 进入次数)`);
  lines.push(`  umw.nodeVisits/solve        med ${s.umw.nodeVisitsPerSolve.median}  (递归节点访问)`);
  const bm=Object.entries(s.umw.byMethod).filter(([,v])=>v.topLevel>0).sort((a,b)=>b[1].topLevel-a[1].topLevel);
  if(bm.length)lines.push(`    flush 归属: ${bm.map(([n,v])=>`${n}×${v.topLevel}`).join(' · ')}`);
  lines.push(`  scoped reads/solve          ${Object.entries(s.scopedReadsPerSolve).map(([n,v])=>`${n} ${v}`).join(' · ')}`);
  const rm=Object.entries(s.rigMethodsPerSolve).filter(([,v])=>v.callsPerSolve>0).sort((a,b)=>b[1].usPerSolve-a[1].usPerSolve);
  lines.push(`  rig methods /solve          ${rm.map(([n,v])=>`${n} ${v.callsPerSolve}×/${fmtUs(v.usPerSolve)}`).join(' · ')}`);
  lines.push(`  attributed Σ ${fmtUs(s.attributedUsPerSolve)} · residual ${fmtUs(s.residualUs)} (内联+模块绑定; pelvisDorsiCorrection med ${fmtUs(s.pelvisDorsiCorrectionUs.median)} p95 ${fmtUs(s.pelvisDorsiCorrectionUs.p95)})`);
  lines.push(`  heapΔ/solve                 mean ${(s.heapDeltaBytesPerSolve.mean/1024).toFixed(1)}KB med ${(s.heapDeltaBytesPerSolve.median/1024).toFixed(1)}KB (noisy)`);
  if(s.skipFlush)lines.push(`  experiment skip-flush       ${s.skipFlush.stubCalls} 次桩调用 / ${s.skipFlush.solves} solves → ${s.skipFlush.identical?'输出 IDENTICAL ✓':'输出 MISMATCH ✗ — '+s.skipFlush.firstMismatch} (${s.skipFlush.compared} scalars, experiment-only)`);
 }
 return lines.join('\n');
}

/* ---- baseline assembly -------------------------------------------------- */

const r4=(x:number)=>+x.toPrecision(4);
const r4s=(s:StageStat):StageStat=>({n:s.n,median:r4(s.median),p95:r4(s.p95),min:r4(s.min),max:r4(s.max)});

/** Granularity-tagged stage stat: 'sample' pools per-sample timings over all
 * measured reps; 'rep' stats run over rep totals / whole calls. */
export interface TimedStat extends StageStat{per:'sample'|'rep';sharePct?:number}
export interface ScenarioResult{
 name:string;fps:number;
 /** Sampled instants per rep (capture grid + authored key times). */
 samples:number;
 doc:{builder:string;sourceSeed:number|null;keys:number;duration:number;inbetweens:boolean;loop:boolean;gripSide:string};
 /** frameAtCompiled/solveEffectiveFrame/analyzePose are per-sample (full
  * pool); buildModel/frameFromModel/frameAt/samplePose are stride-subset
  * compat-path cross-checks; compileMotion and the rest are rep totals. */
 stages:Record<string,TimedStat>;
 /** Issue categories: compile = compileMotion（每rep一次）, sample =
  * frameAtCompiled, solve = solveEffectiveFrame+analyzePose,
  * captureSerialize = residual + stringify. residualUs =
  * median(solveWorkshop) − Σ median(per-rep stage totals) —
  * events/assembly/tail work, never labeled render. */
 rollup:{compile:TimedStat;sample:TimedStat;solve:TimedStat;captureSerialize:TimedStat;residualUs:number};
 /** Workshop live-edit estimate derived from measured numbers — NOT a
  * browser measurement: (frameAtCompiled+solveEffectiveFrame) per frame ×
  * (1 playhead + 61 trajectory + onion solves per rebuild pass). */
 derived:{workshop:{frameAtSolveUs:number;estimateUs:number;factors:{playhead:number;trajectory:number;onion:number};note:string}};
 throughput:{samplesPerSec:number};
 memory:{churnMB:StageStat;heapPostGcMB:number[];pkgKB:number};
}
export interface BaselineFile{
 bench:'workshop-pipeline';version:1;
 run:{command:string;commit:string;
  /** git status --porcelain non-empty at measure time — numbers bind to
   * code state, not just HEAD. */
  dirty:boolean;date:string;
  env:{node:string;platform:string;arch:string;cpu:string;cores:number;totalMemGB:number;three:string;tsx:string};
  params:{seed:number;warmup:number;reps:number;gc:string}};
 scenarios:ScenarioResult[];
 hotspots:{stage:string;sharePct:number}[];
}

/** Fold one scenario's stage-loop + whole-call measurements into the
 * baseline record (µs throughout, rounded to 4 significant figures). */
export function summarizeScenario(spec:BenchDocSpec,doc:WorkshopDoc,fps:number,sl:StageLoopResult,wc:WholeCallResult):ScenarioResult{
 const stages:Record<string,TimedStat>={};
 for(const k of ['frameAtCompiled','solveEffectiveFrame','analyzePose','buildModel','frameFromModel','frameAt','samplePose'] as const)
  stages[k]={...r4s(summarize(sl.perSample[k])),per:'sample'};
 stages.compileMotion={...r4s(summarize(sl.repTotals.compileMotion)),per:'rep'};
 for(const k of ['solveWorkshop','stringify','probeFrames','analyzeProbeFrames','probeDocument'] as const)
  stages[k]={...r4s(summarize(wc.totals[k])),per:'rep'};
 const compile=r4s(summarize(sl.repTotals.compileMotion)),sample=r4s(summarize(sl.repTotals.frameAtCompiled));
 const solve=r4s(summarize(sl.repTotals.solveEffectiveFrame.map((v,i)=>v+sl.repTotals.analyzePose[i])));
 const stringify=summarize(wc.totals.stringify),total=summarize(wc.totals.solveWorkshop);
 const residual=total.median-(compile.median+sample.median+solve.median);
 const captureSerialize:StageStat={n:stringify.n,median:stringify.median+residual,p95:stringify.p95+residual,min:stringify.min+residual,max:stringify.max+residual};
 const share=(s:StageStat)=>r4(total.median>0?100*s.median/total.median:0);
 const rollup:ScenarioResult['rollup']={
  compile:{...compile,per:'rep',sharePct:share(compile)},
  sample:{...sample,per:'rep',sharePct:share(sample)},
  solve:{...solve,per:'rep',sharePct:share(solve)},
  captureSerialize:{...r4s(captureSerialize),per:'rep',sharePct:share(captureSerialize)},
  residualUs:r4(residual)};
 const frameAtSolveUs=r4(medianOf(sl.perSample.frameAtCompiled)+medianOf(sl.perSample.solveEffectiveFrame));
 const factors={playhead:1,trajectory:61,onion:4};
 return {
  name:spec.name,fps,samples:sl.samplesPerRep,
  doc:{builder:spec.builder,sourceSeed:spec.builder==='bench'?spec.seed??null:null,keys:doc.keys.length,duration:r4(doc.duration),
   inbetweens:doc.inbetweens,loop:doc.loop,gripSide:doc.gripSide??'R'},
  stages,rollup,
  derived:{workshop:{frameAtSolveUs,estimateUs:r4(frameAtSolveUs*(factors.playhead+factors.trajectory+factors.onion)),factors,
   note:'估算：引擎 rebuildAux/onion 每次刷新约为 1 播放头 + 61 轨迹采样 + N 洋葱皮帧的 frameAtCompiled+solve；非浏览器实测'}},
  throughput:{samplesPerSec:r4(total.median>0?sl.samplesPerRep/(total.median/1e6):0)},
  memory:{churnMB:r4s(summarize(wc.memory.churnMB)),heapPostGcMB:wc.memory.heapPostGcMB.map(r4),pkgKB:r4(wc.pkgBytes/1024)},
 };
}

/** Scenario share ranking, aggregated over the whole run: each bucket's
 * summed median over summed solveWorkshop medians. */
export function hotspotRanking(scenarios:ScenarioResult[]):{stage:string;sharePct:number}[]{
 const sum=(f:(s:ScenarioResult)=>number)=>scenarios.reduce((a,s)=>a+f(s),0);
 const total=sum(s=>s.stages.solveWorkshop.median);
 const out=(['compile','sample','solve','captureSerialize'] as const).map(stage=>({
  stage,sharePct:r4(total>0?100*sum(s=>s.rollup[stage].median)/total:0)}));
 return out.sort((a,b)=>b.sharePct-a.sharePct);
}

/* ---- reports ------------------------------------------------------------ */

const fmtUs=(x:number)=>Math.abs(x)>=1000?`${(x/1000).toFixed(2)}ms`:`${x.toFixed(1)}µs`;
const cell=(s:TimedStat|StageStat)=>`med ${fmtUs(s.median)} p95 ${fmtUs(s.p95)}`;
const fmtMB=(x:number)=>`${x.toFixed(1)}MB`;

/** The human-readable baseline report — zh conventions like formatProbeReport. */
export function formatReport(b:BaselineFile):string{
 const lines:string[]=[];
 const e=b.run.env;
 lines.push(`=== workshop-pipeline 性能基线 · ${b.run.date} ===`);
 lines.push(`env: node ${e.node} ${e.platform}-${e.arch} · ${e.cpu} ${e.cores}核 ${e.totalMemGB}GB · three ${e.three} · tsx ${e.tsx} · commit ${b.run.commit.slice(0,7)}`);
 lines.push(`cmd: ${b.run.command}`);
 lines.push(`params: seed ${b.run.params.seed} warmup ${b.run.params.warmup} reps ${b.run.params.reps} gc ${b.run.params.gc}`);
 lines.push(`口径: 全部为 µs · 阶段帧级分摊=compile(compileMotion·每rep一次)/sample(frameAtCompiled)/solve(solveEffectiveFrame+analyzePose)/render(未测量) · captureSerialize=残差+stringify`);
 lines.push(`    残差可为负（两段测量回路的中位噪声）；captureSerialize 含 stringify，四桶份额不必合计 100%`);
 for(const s of b.scenarios){
  lines.push(`\n=== ${s.name} @${s.fps}fps · ${s.samples} samples · ${s.doc.keys} keys · ${s.doc.duration}s · ${s.doc.builder}${s.doc.sourceSeed!==null?` seed${s.doc.sourceSeed}`:''}${s.doc.inbetweens?'':' · 无补间'} ===`);
  const st=s.stages;
  lines.push(`  每样本 (n=${st.frameAtCompiled.n}):`);
  for(const k of ['frameAtCompiled','solveEffectiveFrame','analyzePose'] as const)
   lines.push(`    ${k.padEnd(20)} ${cell(st[k])}`);
  for(const k of ['buildModel','frameFromModel','frameAt','samplePose'] as const)
   lines.push(`    ${k.padEnd(20)} ${cell(st[k])}  (compat 交叉校验 n=${st[k].n})`);
  lines.push(`  每rep (n=${st.solveWorkshop.n}):`);
  for(const k of ['compileMotion','solveWorkshop','stringify','probeFrames','analyzeProbeFrames','probeDocument'] as const)
   lines.push(`    ${k.padEnd(20)} ${cell(st[k])}`);
  const r=s.rollup;
  lines.push(`  roll-up (占 solveWorkshop median ${fmtUs(st.solveWorkshop.median)} 的份额):`);
  lines.push(`    compile          = compileMotion（每rep一次）     ${cell(r.compile)}  ${r.compile.sharePct}%`);
  lines.push(`    sample           = frameAtCompiled                ${cell(r.sample)}  ${r.sample.sharePct}%`);
  lines.push(`    solve            = solveEffectiveFrame+analyzePose ${cell(r.solve)}  ${r.solve.sharePct}%`);
  lines.push(`    captureSerialize = 残差+stringify                 ${cell(r.captureSerialize)}  ${r.captureSerialize.sharePct}%  (残差 ${fmtUs(r.residualUs)})`);
  lines.push(`    render           = 未测量（浏览器侧另计；captureSerialize 残差见上）`);
  lines.push(`  吞吐: ${s.throughput.samplesPerSec} samples/s · 包体 ${s.memory.pkgKB}KB`);
  const d=s.derived.workshop;
  lines.push(`  derived.workshop 拖拽/洋葱皮估算: frameAtCompiled+solve ${fmtUs(d.frameAtSolveUs)}/帧 × (${d.factors.playhead} 播放头 + ${d.factors.trajectory} 轨迹 + ${d.factors.onion} 洋葱皮) ≈ ${fmtUs(d.estimateUs)}/刷新 — 估算非实测`);
  const m=s.memory;
  lines.push(`  内存: churn med ${fmtMB(m.churnMB.median)} p95 ${fmtMB(m.churnMB.p95)} /rep${m.heapPostGcMB.length?` · post-gc heap ${m.heapPostGcMB.map(v=>v.toFixed(0)).join('→')}MB`:' · post-gc 不可用'}`);
 }
 lines.push(`\n=== hotspots（全场景份额排序）===`);
 b.hotspots.forEach((h,i)=>lines.push(`  ${i+1}. ${h.stage.padEnd(18)} ${h.sharePct}%`));
 lines.push(`  render             未测量（浏览器侧另计）`);
 return lines.join('\n');
}

/** Baseline-vs-baseline deltas: per-scenario median/p95 % change of the
 * primary stage and whole-call stats. Same-machine comparison ONLY — the
 * header says so, because cross-machine absolute deltas are not evidence. */
export function diffBaselines(oldB:BaselineFile,newB:BaselineFile):string{
 const lines:string[]=[];
 lines.push(`=== 基线对比 ${oldB.run.date} → ${newB.run.date} ===`);
 lines.push(`⚠ 仅同机同环境可比：不同机器/负载的绝对数字不构成加速证据；median 噪声按 ±5% 计、p95 更噪。`);
 const key=(s:ScenarioResult)=>`${s.name}@${s.fps}`;
 const prev=new Map(oldB.scenarios.map(s=>[key(s),s]));
 const pct=(o:number,n:number)=>o>0?`${n-o>=0?'+':''}${(100*(n-o)/o).toFixed(1)}%`:'—';
 const row=(label:string,o?:StageStat,n?:StageStat,ref=0)=>{
  if(!o||!n)return;
  /* A near-zero or negative denominator (the capture residual is a small
   * difference of two large medians) makes % deltas pure noise — report the
   * absolute µs delta instead. */
  if(ref>0&&o.median<ref*.05){
   const d=(x:number)=>`${x>=0?'+':''}${(x/1000).toFixed(2)}ms`;
   lines.push(`    ${label.padEnd(20)} med ${d(n.median-o.median).padStart(9)}  p95 ${d(n.p95-o.p95).padStart(9)}  (残差基数近零，按绝对差)`);
   return;
  }
  lines.push(`    ${label.padEnd(20)} med ${pct(o.median,n.median).padStart(7)}  p95 ${pct(o.p95,n.p95).padStart(7)}`);
 };
 for(const s of newB.scenarios){
  const o=prev.get(key(s));
  if(!o){lines.push(`  [${key(s)}] (旧基线无此场景)`);continue;}
  lines.push(`  [${key(s)}]`);
  for(const k of ['compileMotion','frameAtCompiled','buildModel','frameFromModel','solveEffectiveFrame','analyzePose','solveWorkshop','stringify','probeFrames','analyzeProbeFrames','probeDocument'] as const)
   row(k,o.stages[k],s.stages[k]);
  const total=Math.abs(o.stages.solveWorkshop.median);
  for(const k of ['compile','sample','solve','captureSerialize'] as const)
   row(`rollup.${k}`,o.rollup[k],s.rollup[k],k==='captureSerialize'?total:0);
 }
 return lines.join('\n');
}
